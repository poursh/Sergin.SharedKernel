@* A schedule's runs, and one run's items. The dialog is opened by a click on the schedule's row. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Heading</MudText>
    </TitleContent>
    <DialogContent>
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (runs.Count == 0)
        {
            <MudText Typo="Typo.body2">@Localizer.Text(TaskUiTexts.Runs.NoRuns)</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Bordered="true" Class="sergin-runs">
                <thead>
                    <tr>
                        <th>@Localizer.Text(TaskUiTexts.Runs.Started)</th>
                        <th>@Localizer.Text(TaskUiTexts.Runs.Trigger)</th>
                        <th>@Localizer.Text(TaskUiTexts.Runs.ActedBy)</th>
                        <th>@Localizer.Text(TaskUiTexts.Runs.Status)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TaskRunListItem run in runs)
                    {
                        <tr>
                            <td>@Time(run.StartedAtUtc)</td>
                            <td>@TriggerText(run.Trigger)</td>
                            <td>@NameOf(run.ActingUserId)</td>
                            <td>@SummaryText(run)</td>
                            <td>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ShowItemsAsync(run.Id))">@Localizer.Text(TaskUiTexts.Runs.ShowItems)</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (openRun is not null)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">@Localizer.Text(TaskUiTexts.Runs.Items)</MudText>
                <SerginRunItemsTable Items="items" RunScope="openRunScope" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Localizer.Text(CommonTexts.Close)</MudButton>
    </DialogActions>
</MudDialog>
