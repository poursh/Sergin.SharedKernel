@* The signed-in user's background runs, in the app bar: the Activity button, whose badge counts the unfinished ones,
   opening a modal of the running runs and those finished in the last 24 hours. Nothing renders until the first load
   succeeds, which is after the first interactive render, so the prerender carries none of it. *@
@if (Visible)
{
    <style>
        .sergin-activity-button { text-transform: none; }
        .sergin-activity-content { max-height: 70vh; overflow-y: auto; }
        .sergin-activity-row + .sergin-activity-row { border-top: 1px solid var(--mud-palette-lines-default); }
    </style>
    <div class="sergin-activity d-flex align-center">
        <MudBadge Content="@RunningCountText" Visible="@(RunningCount > 0)" Color="Color.Secondary" Overlap="true" Origin="Origin.TopRight">
            <MudButton StartIcon="@Icons.Material.Outlined.WorkHistory" Color="Color.Inherit" Variant="Variant.Text" title="@OpenLabel"
                       aria-label="@OpenLabel" aria-haspopup="dialog" aria-expanded="@(open ? "true" : "false")" Class="sergin-activity-button"
                       OnClick="ToggleAsync">
                @Localizer.Text(TaskUiTexts.Activity.Heading)
            </MudButton>
        </MudBadge>
        <MudDialog @bind-Visible="open" Options="dialogOptions" Class="sergin-activity-dialog" ContentClass="sergin-activity-content">
            <TitleContent>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Outlined.WorkHistory" />
                    <MudText Typo="Typo.h6">@Localizer.Text(TaskUiTexts.Activity.Heading)</MudText>
                </div>
            </TitleContent>
            <DialogContent>
                @foreach ((TextDefinition heading, IReadOnlyList<ActivityRow> sectionRows) in Sections)
                {
                    <MudText Typo="Typo.overline" Class="d-block">@Localizer.Text(heading)</MudText>
                    @if (sectionRows.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Localizer.Text(TaskUiTexts.Activity.NothingRunning)</MudText>
                    }
                    @foreach (ActivityRow row in sectionRows)
                    {
                        <div class="sergin-activity-row py-2" @key="row.Ref">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@IconOf(row)" Color="@ColorOf(row)" Size="Size.Small" />
                                <div class="flex-grow-1 d-flex align-baseline flex-wrap gap-x-2">
                                    <MudText Typo="Typo.body2"><b>@CommandText(row)</b></MudText>
                                    @if (row.ModuleCaption is { } caption)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Localizer.Text(caption)</MudText>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@WhenText(row)</MudText>
                                @if (row.IsRunning)
                                {
                                    <MudIconButton Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" title="@CancelLabel"
                                                   aria-label="@CancelLabel" OnClick="@(() => CancelAsync(row.Ref))" />
                                }
                            </div>
                            <div class="d-flex align-center gap-2 ms-6">
                                @if (row.Href is { } href)
                                {
                                    <MudLink Href="@href" Typo="Typo.body2" OnClick="Close">@row.Target</MudLink>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">@row.Target</MudText>
                                }
                                @if (row.Total > 1)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@ProgressText(row)</MudText>
                                }
                                @if (row.State == ActivityState.Cancelled)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Localizer.Text(TaskUiTexts.Activity.Cancelled)</MudText>
                                }
                            </div>
                            @if (row.IsRunning)
                            {
                                if (row.Total > 1)
                                {
                                    <MudProgressLinear Value="@row.Done" Max="@row.Total" Color="Color.Primary" Class="ms-6 mt-1" />
                                }
                                else if (row.Progress is { } progress)
                                {
                                    <MudProgressLinear Value="@progress" Max="100" Color="Color.Primary" Class="ms-6 mt-1" />
                                }
                                else
                                {
                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="ms-6 mt-1" />
                                }
                            }
                            @if (ErrorText(row) is { } error)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block ms-6">@error</MudText>
                            }
                        </div>
                    }
                }
            </DialogContent>
            <DialogActions>
                @if (Finished.Count > 0)
                {
                    <MudButton Variant="Variant.Text" OnClick="ClearAsync">@Localizer.Text(TaskUiTexts.Activity.Clear)</MudButton>
                }
                <MudButton OnClick="Close">@Localizer.Text(CommonTexts.Close)</MudButton>
            </DialogActions>
        </MudDialog>
    </div>
}
