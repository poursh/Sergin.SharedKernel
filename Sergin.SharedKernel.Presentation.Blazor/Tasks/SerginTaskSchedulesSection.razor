@* A record's schedules (or a collection task's in one scope), embedded: the shared entity-list section frame (title, count, outline), then the table. It renders
   its rows on the first pass, not after it, because the list is short and unpaged, so the prerender already shows it.
   The row commands sit in a span that stops the click, so using one does not also open the runs. *@
@if (visible)
{
    <div id="@ElementId">
    <SerginEntityListView TitleText="TaskUiTexts.Title" Count="shownTasks.Count" Problem="problem">
        @if (CommandName is not null)
        {
            <MudChip T="string" Size="Size.Small" OnClose="ClearFilterAsync" Class="mb-2 sergin-scheduled-filter">
                @Localizer.Text(TaskUiTexts.FilteredTo, new { Command = FilteredCommandText })
            </MudChip>
        }
        @if (!Engine.FiresTriggers)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3 sergin-scheduled-runs-off">@Localizer.Text(TaskUiTexts.EngineOff)</MudAlert>
        }
        <MudTable T="TaskScheduleListItem" Items="shownTasks" Hover="true" Striped="true" Bordered="true" Dense="true" Elevation="0"
                  OnRowClick="ShowRunsAsync" RowStyle="cursor: pointer;">
            <HeaderContent>
                <MudTh>@Localizer.Text(TaskUiTexts.Columns.Command)</MudTh>
                <MudTh>@Localizer.Text(TaskUiTexts.Columns.Schedule)</MudTh>
                <MudTh>@Localizer.Text(TaskUiTexts.Columns.NextRun)</MudTh>
                <MudTh>@Localizer.Text(TaskUiTexts.Columns.LastOutcome)</MudTh>
                <MudTh>@Localizer.Text(TaskUiTexts.Columns.State)</MudTh>
                <MudTh Style="width: 1%;" />
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Localizer.Text(TaskUiTexts.Columns.Command)"><div class="d-flex align-center gap-2 sergin-scheduled-command">@if (CommandIcon(context.CommandName) is { } icon){<MudIcon Icon="@icon" Size="Size.Small" Color="Color.Primary" />}<span>@CommandText(context.CommandName)</span></div></MudTd>
                <MudTd DataLabel="@Localizer.Text(TaskUiTexts.Columns.Schedule)"><code>@context.Cron</code> <MudText Typo="Typo.caption" Class="d-inline">@context.TimeZoneId</MudText></MudTd>
                <MudTd DataLabel="@Localizer.Text(TaskUiTexts.Columns.NextRun)">@NextRunText(context)</MudTd>
                <MudTd DataLabel="@Localizer.Text(TaskUiTexts.Columns.LastOutcome)">@LastOutcomeText(context)</MudTd>
                <MudTd DataLabel="@Localizer.Text(TaskUiTexts.Columns.State)">
                    <MudChip T="string" Size="Size.Small" Color="@(context.State == TaskScheduleState.Active ? Color.Success : Color.Default)">
                        @Localizer.Text(context.State == TaskScheduleState.Active ? TaskUiTexts.States.Active : TaskUiTexts.States.Paused)
                    </MudChip>
                </MudTd>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    <span @onclick:stopPropagation="true">
                        <MudTooltip Text="@Localizer.Text(TaskUiTexts.RunNow)">
                            <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small" aria-label="@Localizer.Text(TaskUiTexts.RunNow)"
                                           OnClick="@(() => RunNowAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="@Localizer.Text(context.State == TaskScheduleState.Active ? TaskUiTexts.Pause : TaskUiTexts.Resume)">
                            <MudIconButton Icon="@(context.State == TaskScheduleState.Active ? Icons.Material.Outlined.Pause : Icons.Material.Outlined.PlayCircleOutline)"
                                           Size="Size.Small" aria-label="@Localizer.Text(context.State == TaskScheduleState.Active ? TaskUiTexts.Pause : TaskUiTexts.Resume)"
                                           OnClick="@(() => TogglePauseAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="@Localizer.Text(CommonTexts.Edit)">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@Localizer.Text(CommonTexts.Edit)"
                                           OnClick="@(() => EditAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="@Localizer.Text(CommonTexts.Delete)">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="@Localizer.Text(CommonTexts.Delete)"
                                           OnClick="@(() => DeleteAsync(context))" />
                        </MudTooltip>
                    </span>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">@Localizer.Text(EmptyText)</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">@Localizer.Text(TaskUiTexts.OneOffRuns)</MudText>
        @if (oneOffRuns.Count == 0)
        {
            <MudText Typo="Typo.body2">@Localizer.Text(TaskUiTexts.OneOffEmpty)</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Bordered="true" Class="sergin-one-off-runs">
                <thead>
                    <tr>
                        <th>@Localizer.Text(TaskUiTexts.Columns.Command)</th>
                        <th>@Localizer.Text(TaskUiTexts.Runs.Started)</th>
                        <th>@Localizer.Text(TaskUiTexts.Runs.ActedBy)</th>
                        <th>@Localizer.Text(TaskUiTexts.Runs.Status)</th>
                        <th style="width: 1%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TaskRunListItem run in oneOffRuns)
                    {
                        <tr>
                            <td><div class="d-flex align-center gap-2 sergin-scheduled-command">@if (CommandIcon(run.CommandName) is { } icon){<MudIcon Icon="@icon" Size="Size.Small" Color="Color.Primary" />}<span>@CommandText(run.CommandName)</span></div></td>
                            <td>@Time(run.StartedAtUtc)</td>
                            <td>@NameOf(run.ActingUserId)</td>
                            <td>
                                <div class="d-flex align-center gap-2">
                                    @if (run.Status == TaskRunStatus.Running)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" Class="sergin-one-off-progress" />
                                    }
                                    <span>@OneOffSummaryText(run)</span>
                                </div>
                            </td>
                            <td style="white-space: nowrap; text-align: right;">
                                @if (run.Status == TaskRunStatus.Running && !run.Cancelable)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Localizer.Text(TaskUiTexts.Activity.NotCancelable)</MudText>
                                }
                                else if (run.Status == TaskRunStatus.Running)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Cancel"
                                               Class="sergin-one-off-cancel" OnClick="@(() => CancelRunAsync(run.Id))">
                                        @Localizer.Text(TaskUiTexts.Activity.Cancel)
                                    </MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </SerginEntityListView>
    </div>
}
