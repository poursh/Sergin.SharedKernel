<MudNavMenu Bordered="true">
    @foreach (NavEntry entry in entries)
    {
        @if (entry.Section is { } section)
        {
            <MudNavGroup Title="@Localizer.Text(section.Group.Title)"
                         Icon="@section.Group.Icon"
                         Expanded="@IsExpanded(section.Group)"
                         ExpandedChanged="@ExpandedChangedFor(section.Group)">
                @foreach (SerginNavSubsection subsection in section.Subsections)
                {
                    @if (section.ShowsCaptions)
                    {
                        @if (!IsFirst(section, subsection))
                        {
                            <MudDivider Class="sergin-nav-divider ms-9 me-4 my-1" />
                        }
                        @if (subsection.Caption is { } caption)
                        {
                            <MudText Typo="Typo.overline" Class="sergin-nav-caption mud-text-secondary d-block ps-9 pe-4 pt-2" role="heading" aria-level="3">
                                @Localizer.Text(caption)
                            </MudText>
                        }
                    }
                    @foreach (SerginNavItem item in subsection.Items)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="@MatchFor(item)">
                            @Localizer.Text(item.Label)
                        </MudNavLink>
                    }
                }
            </MudNavGroup>
        }
        else if (entry.Link is { } link)
        {
            <MudNavLink Href="@link.Href" Icon="@link.Icon" Match="@MatchFor(link)">
                @Localizer.Text(link.Label)
            </MudNavLink>
        }
    }
</MudNavMenu>
