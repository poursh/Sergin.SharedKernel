@inherits LayoutComponentBase

@* Default browser-tab title. A page rendering its own <PageTitle> overrides this, because HeadOutlet
   keeps the last one rendered and the body renders after the layout. *@
<PageTitle>@ApplicationName</PageTitle>

@* MudBlazor 9 has no global default for a button's size, so the page and dialog buttons that ask for none (Size.Medium)
   get the Small metrics here. The app bar and drawer sit outside .mud-main-content and keep theirs; an explicit
   Small or Large keeps its own. A style element rather than scoped CSS, as in SerginPageHeader. *@
<style>
    :is(.mud-main-content, .mud-dialog) .mud-button-text:not(.mud-button-text-size-small, .mud-button-text-size-large) { padding: 4px 5px; font-size: .8125rem; }
    :is(.mud-main-content, .mud-dialog) .mud-button-outlined:not(.mud-button-outlined-size-small, .mud-button-outlined-size-large) { padding: 3px 9px; font-size: .8125rem; }
    :is(.mud-main-content, .mud-dialog) .mud-button-filled:not(.mud-button-filled-size-small, .mud-button-filled-size-large) { padding: 4px 10px; font-size: .8125rem; }
    :is(.mud-main-content, .mud-dialog) .mud-icon-button:not(.mud-icon-button-size-small, .mud-icon-button-size-large) { padding: 3px; font-size: 1.125rem; }
    .mud-main-content .mud-card-actions { gap: 12px; padding: 8px 16px 16px; }
    .sergin-search .mud-input-root-outlined.mud-input-root-margin-dense { padding: 4px 8px; font-size: .8125rem; }
    .sergin-search .mud-input-adornment .mud-icon-root { font-size: 1.125rem; }
</style>

<MudThemeProvider Theme="themeManagerTheme.Theme" @bind-IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="themeManagerTheme.AppBarElevation" >
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">@ApplicationName</MudText>
        <MudSpacer />
        @* Keyed on the scope like the drawer and the page, so it renders the new scope after a change. *@
        @if (scopeReady)
        {
            <SerginScopePicker @key="scopeVersion" ScopeChanged="OnScopeChanged" />
        }
        <MudText Typo="Typo.body2" Class="mr-3">@DisplayName</MudText>
        @* A form rather than a link: a GET sign-out can be triggered by any third-party page that
           embeds the URL. The token satisfies the antiforgery middleware the host leaves enabled. *@
        @if (Authentication.CanSignOut)
        {
            <form method="post" action="@Authentication.LogoutPath" class="d-flex align-center mr-2">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Logout">
                    @Localizer["Sign out"]
                </MudButton>
            </form>
        }
        <MudIconButton Icon="@DarkModeIcon" Color="Color.Inherit" Edge="Edge.End"
                       title="@DarkModeLabel" aria-label="@DarkModeLabel"
                       OnClick="ToggleDarkMode" />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="themeManagerTheme.DrawerElevation"
               ClipMode="themeManagerTheme.DrawerClipMode">
        @* Keyed on the scope, so a scope change rebuilds the drawer and answers its permissions again. *@
        @if (scopeReady)
        {
            <SerginNavMenu @key="scopeVersion" />
        }
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @* Filled by the page's <SerginBreadcrumbs>, which projects its strip here through a section: the
               shell owns where every trail sits, the page owns what it says. Empty on a page without one. *@
            <SectionOutlet SectionId="SerginBreadcrumbs.SectionId" />
            @* Keyed for the same reason: the page reloads its data on the new scope. Rendered only once the
               session settled the scope, so a page never loads on one the user cannot work in. *@
            @if (scopeReady)
            {
                <div @key="scopeVersion">
                    @Body
                </div>
            }
        </MudContainer>
    </MudMainContent>

    @* Design-time tool for live-editing the MudTheme. Gated on the environment rather than compiled
       out, so a host that does run outside Development never exposes it — see ShowThemeManager. *@
    @if (ShowThemeManager)
    {
        <MudThemeManagerButton OnClick="OpenThemeManager" />
        <MudThemeManager @bind-Open="themeManagerOpen"
                         Theme="themeManagerTheme"
                         ThemeChanged="OnThemeChanged"
                         IsDarkMode="isDarkMode" />
    }
</MudLayout>
