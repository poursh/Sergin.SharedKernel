@* The language the page shows in, in the app bar; hidden while only the default language is offered. A menu of the
   offered languages, the current one ticked: each item is a full navigation to the switch, because Blazor Server fixes
   the culture per circuit. The menu opens once the circuit is live; before that the button shows the current language. *@
@if (languages.Count > 1)
{
    <MudMenu Class="sergin-language-switcher" AriaLabel="@Label"
             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        @* MudBlazor 9 does not wire a custom activator: the button opens the menu through the MenuContext it is given. *@
        <ActivatorContent>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="sergin-appbar-item" title="@Label"
                       StartIcon="@Icons.Material.Filled.Translate" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                       OnClick="@(args => context.ToggleAsync(args))">
                @CurrentLabel
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            @foreach (LanguageChoice language in languages)
            {
                <MudMenuItem Href="@HrefFor(language)" ForceLoad="true"
                             Icon="@Icons.Material.Filled.Check" IconColor="@(IsCurrent(language) ? Color.Inherit : Color.Transparent)">
                    @language.Label
                </MudMenuItem>
            }
        </ChildContent>
    </MudMenu>
}
