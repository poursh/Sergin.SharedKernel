<MudItem xs="6" md="3">
    <MudPaper Outlined="true" Class="pa-3 sergin-overview-card">
        <MudText Typo="Typo.caption">@Localizer[Label]</MudText>
        <MudText Typo="Typo.h5">@(string.IsNullOrEmpty(Value) ? "–" : Value)</MudText>
        <MudText Typo="Typo.caption" Style="opacity: 0.7;">@Caption</MudText>
    </MudPaper>
</MudItem>
