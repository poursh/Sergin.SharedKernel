@* A detail view's labelled fields, laid out on the grid: three to a row from sm up, one per row below. *@
<MudPaper Outlined="true" Class="pa-4 mb-4 sergin-detail">
    @if (Title is not null)
    {
        <MudText Typo="Typo.h5" Class="mb-3">@Title</MudText>
    }
    <MudGrid Spacing="3">
        @ChildContent
    </MudGrid>
</MudPaper>
