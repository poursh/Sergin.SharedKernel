@* The modal SerginInfoButton opens: scope, then version, then audit stamps — where the record lives, what the page
   checks its writes against, then its history. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["Information"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (audit is not null)
        {
            <MudText Typo="Typo.subtitle2">@Localizer["Scope"]</MudText>
            @if (audit.ScopeId is null)
            {
                <MudText Typo="Typo.body2">@Localizer["Global"]</MudText>
                <MudText Typo="Typo.caption" Class="d-block">@Localizer["This record belongs to no scope."]</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">@ScopeName</MudText>
                @if (ScopePath is { } path)
                {
                    <MudText Typo="Typo.caption" Class="d-block">@path</MudText>
                }
            }

            @if (Version is not null)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">@Localizer["Version"]</MudText>
                <MudText Typo="Typo.body2" Style="font-family: monospace;" title="@Version.Value.ToString()">@ShortVersion</MudText>
                <MudText Typo="Typo.caption" Class="d-block">@Localizer["Edits and deletes are checked against this version."]</MudText>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">@Localizer["Audit"]</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="sergin-audit">
                <tbody>
                    <tr>
                        <td><MudText Typo="Typo.caption">@Localizer["Created"]</MudText></td>
                        <td><MudText Typo="Typo.body2">@FormatTime(audit.CreatedAtUtc) @Localizer["by"] @NameOf(audit.CreatedBy)</MudText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">@Localizer["Modified"]</MudText></td>
                        <td>
                            @if (audit.ModifiedAtUtc is { } modifiedAt)
                            {
                                <MudText Typo="Typo.body2">@FormatTime(modifiedAt) @Localizer["by"] @NameOf(audit.ModifiedBy)</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@Localizer["Never"]</MudText>
                            }
                        </td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        }
        else if (failure is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Error">@failure</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>
