@* A ⋮ menu of SerginPageActions, permission-filtered like the actions bar; danger items in the error colour.
   Renders nothing while no action is visible. *@
@if (visibleActions.Count > 0)
{
    <MudMenu Icon="@Icon" Size="Size.Small" Dense="true" AriaLabel="@AriaLabelShown" Class="@Class"
             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        @foreach (SerginPageAction action in visibleActions)
        {
            <MudMenuItem Icon="@action.Icon" IconColor="@(action.Kind == SerginActionKind.Danger ? Color.Error : Color.Default)"
                         Class="@(action.Kind == SerginActionKind.Danger ? "mud-error-text" : null)"
                         Href="@action.Href" OnClick="action.OnClick" Disabled="action.Disabled">
                @Localizer.Text(action.Label)
            </MudMenuItem>
            @foreach (SerginMenuItem item in action.MenuItems ?? [])
            {
                <MudMenuItem Icon="@item.Icon" OnClick="item.OnClick">
                    @(item.LabelArguments is null ? Localizer.Text(item.Label) : Localizer.Text(item.Label, item.LabelArguments))
                </MudMenuItem>
            }
        }
    </MudMenu>
}
