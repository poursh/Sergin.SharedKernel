@* One SerginPageAction as an icon button with its label as tooltip and accessible name; nothing when the user lacks
   its permission. *@
@if (visible)
{
    <MudTooltip Text="@Localizer[Action.Label]">
        <MudIconButton Icon="@(Action.Icon ?? Icons.Material.Filled.Add)" Size="Size.Small" Href="@Action.Href"
                       OnClick="Action.OnClick" Disabled="Action.Disabled" aria-label="@Localizer[Action.Label]"
                       Color="@(Action.Kind == SerginActionKind.Danger ? Color.Error : Color.Default)" />
    </MudTooltip>
}
