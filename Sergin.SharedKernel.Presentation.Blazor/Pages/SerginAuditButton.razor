@* Loaded when opened, not with the page: the stamps are what few visits look at, and loading on open also
   shows what the last save wrote without a page reload. *@
<MudMenu Icon="@Icons.Material.Outlined.History" Size="Size.Small" AriaLabel="@Localizer["Audit & version"]"
         OpenChanged="OnOpenChangedAsync" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <div class="pa-3" style="min-width: 260px;">
        <MudText Typo="Typo.subtitle2" Class="mb-2">@Localizer["Audit & version"]</MudText>
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (audit is not null)
        {
            <MudSimpleTable Dense="true" Elevation="0" Class="sergin-audit">
                <tbody>
                    <tr>
                        <td><MudText Typo="Typo.caption">@Localizer["Created"]</MudText></td>
                        <td><MudText Typo="Typo.body2">@FormatTime(audit.CreatedAtUtc)<br />@Localizer["by"] @NameOf(audit.CreatedBy)</MudText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.caption">@Localizer["Modified"]</MudText></td>
                        <td>
                            @if (audit.ModifiedAtUtc is { } modifiedAt)
                            {
                                <MudText Typo="Typo.body2">@FormatTime(modifiedAt)<br />@Localizer["by"] @NameOf(audit.ModifiedBy)</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@Localizer["Never"]</MudText>
                            }
                        </td>
                    </tr>
                    @if (Version is not null)
                    {
                        <tr>
                            <td><MudText Typo="Typo.caption">@Localizer["Row version"]</MudText></td>
                            <td><MudText Typo="Typo.body2" Style="font-family: monospace;" title="@Version.Value.ToString()">@ShortVersion</MudText></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            @if (Version is not null)
            {
                <MudText Typo="Typo.caption" Class="mt-2 d-block">@Localizer["Edits and deletes are checked against this version."]</MudText>
            }
        }
        else if (failure is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Error">@failure</MudText>
        }
    </div>
</MudMenu>
