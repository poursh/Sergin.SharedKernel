@* One view, three shapes. On a page: the page title and header row go to the layout, then the problem, the overview,
   the actions bar and the body. In a pane: the same, except the header buttons go to the pane's header section and
   the page title and trail stay the pane owner's. Embedded: an outlined, titled, collapsible section holding the same parts and no
   header — collapsing hides the parts but keeps them rendered, so the body's state and the count stay live. Either
   way the body sees an embedded host, so a nested view renders as a section. *@
@if (Host.IsPage || Host.IsPane)
{
    @if (Host.IsPage)
    {
        <PageTitle>@Title</PageTitle>
        <SerginPageHeader Trail="Trail">@HeaderActions</SerginPageHeader>
    }
    else if (HeaderActions is not null)
    {
        <SectionContent SectionId="Host.HeaderSectionId">@HeaderActions</SectionContent>
    }
    <SerginProblemPanel Problem="Problem" />

    @if (Ready)
    {
        <div class="sergin-view sergin-aggregate-page">
            <SerginViewBody Overview="Overview" OverviewSummary="OverviewSummary" OverviewCollapsed="OverviewCollapsed"
                            Actions="Actions" ActionsClass="mb-3" Host="bodyHost">
                @ChildContent
            </SerginViewBody>
        </div>
    }
}
else
{
    <section class="sergin-view sergin-entity-list-section border border-solid mud-border-lines-default rounded pa-3 mb-3" aria-label="@Localizer[Title]">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudText Typo="Typo.h6">@Localizer[Title]@(Count is { } count ? $" · {count}" : string.Empty)</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Toggle" aria-expanded="@(collapsed ? "false" : "true")"
                       EndIcon="@(collapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)">
                @(collapsed ? Localizer["Expand"] : Localizer["Collapse"])
            </MudButton>
        </MudStack>
        <div class="@(collapsed ? "d-none" : null)">
            <SerginProblemPanel Problem="Problem" />
            @if (Ready)
            {
                <SerginViewBody Overview="Overview" OverviewSummary="OverviewSummary" OverviewCollapsed="OverviewCollapsed"
                                Actions="Actions" ActionsClass="mb-2" Host="bodyHost">
                    @ChildContent
                </SerginViewBody>
            }
        </div>
    </section>
}
