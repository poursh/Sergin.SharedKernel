@* An aggregate's record: its fields, then the entity collections inside it. *@
<SerginAggregateView TitleText="TitleText" Trail="Trail" HeaderActions="HeaderActions" Problem="Problem" Ready="Ready"
                     Overview="Overview" OverviewSummary="OverviewSummary" OverviewCollapsed="OverviewCollapsed"
                     Actions="Actions" Count="Count" Collapsed="Collapsed">
    <SerginDetailFields TitleData="@FieldsTitleData" TitleText="FieldsTitleText">
        @Fields
    </SerginDetailFields>
    @Entities
</SerginAggregateView>
