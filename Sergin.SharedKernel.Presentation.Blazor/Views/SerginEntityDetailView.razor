@* An entity's record: the shared view shape with its fields as the body. *@
<SerginView Title="@Title" Trail="Trail" HeaderActions="HeaderActions" Problem="Problem" Ready="Ready"
            Overview="Overview" OverviewSummary="OverviewSummary" OverviewCollapsed="OverviewCollapsed"
            Actions="Actions" Count="Count" Collapsed="Collapsed">
    <SerginDetailFields Title="@FieldsTitle">
        @Fields
    </SerginDetailFields>
</SerginView>
