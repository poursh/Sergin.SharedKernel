@* Development-only: a floating button that opens a dialog to set the scope the circuit works in. *@
@if (Visible)
{
    <div style="position: fixed; right: 24px; bottom: 24px; z-index: var(--mud-zindex-appbar);">
        <MudTooltip Text="@Tooltip" Placement="Placement.Left">
            <MudFab Color="Color.Secondary" Size="Size.Medium" StartIcon="@Icons.Material.Filled.AccountTree"
                    aria-label="@Localizer["Set scope"]" OnClick="Open" />
        </MudTooltip>
    </div>

    <MudDialog @bind-Visible="open" Options="DialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@Localizer["Set scope"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="scopeText" Label="@Localizer["Scope id"]" Immediate="true"
                          Error="@(error is not null)" ErrorText="@error" AutoFocus="true" />
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" OnClick="ResetAsync">@Localizer["Use root"]</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text" OnClick="Close">@Localizer["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="applying"
                       OnClick="ApplyAsync">@Localizer["Set"]</MudButton>
        </DialogActions>
    </MudDialog>
}
