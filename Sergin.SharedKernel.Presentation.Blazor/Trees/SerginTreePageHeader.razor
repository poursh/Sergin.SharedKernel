@* The header above a tree page's content: the selected node's path on the left (the group's title when the page has
   several groups, then the ancestors, each selecting itself, then the node, then the page's tail such as "New scope"), and on the right the pane view's header
   buttons — projected into the outlet by the view — the node's ⋮ menu and a close button that clears the selection. *@
<div class="sergin-tree-page-header d-flex align-center mb-3">
    <div class="sergin-tree-page-header-path d-flex align-center">
        @if (GroupTitle is not null)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnGroup">@Localizer[GroupTitle]</MudButton>
            @if (Node is not null)
            {
                <span class="sergin-tree-separator" aria-hidden="true">›</span>
            }
        }
        @if (Node is null)
        {
            @if (Tail is null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Localizer["No node selected"]</MudText>
            }
        }
        else
        {
            @foreach (SerginTreePathStep step in Node.Ancestors)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@step.Icon"
                           OnClick="@(() => OnAncestor.InvokeAsync(step.Id))">@step.Label</MudButton>
                <span class="sergin-tree-separator" aria-hidden="true">›</span>
            }
            @if (Node.Icon is not null)
            {
                <MudIcon Icon="@Node.Icon" Size="Size.Small" Class="mr-1" />
            }
            @if (Tail is null)
            {
                <MudText Typo="Typo.subtitle1" Class="sergin-tree-text" aria-current="page"><b>@Node.Label</b></MudText>
            }
            else
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => OnAncestor.InvokeAsync(Node.Id))">@Node.Label</MudButton>
                <span class="sergin-tree-separator" aria-hidden="true">›</span>
            }
        }
        @if (Tail is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="sergin-tree-text sergin-tree-tail" aria-current="page"><b>@Localizer[Tail]</b></MudText>
        }
    </div>
    <MudSpacer />
    <div class="d-flex align-center justify-end" style="flex: 0 0 auto; gap: 2px;">
        <SectionOutlet SectionId="HeaderSectionId" />
        @if (Node is not null)
        {
            <SerginActionMenu Actions="Node.Menu" />
            <MudTooltip Text="@Localizer["Close"]">
                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="OnClose"
                               aria-label="@Localizer["Close"]" Class="sergin-tree-close" />
            </MudTooltip>
        }
    </div>
</div>
