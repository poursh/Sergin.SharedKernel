@* A task's argument form in a dialog: the task's label as title, the form, Start and Cancel. A refused start keeps the
   dialog open with the values entered. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer.Text(Command.Label)</MudText>
    </TitleContent>
    <DialogContent>
        <GeneratedTaskForm Command="Command" Targets="Targets" OnStarted="OnStarted">
            <MudButton OnClick="Cancel">@Localizer.Text(CommonTexts.Cancel)</MudButton>
        </GeneratedTaskForm>
    </DialogContent>
</MudDialog>
