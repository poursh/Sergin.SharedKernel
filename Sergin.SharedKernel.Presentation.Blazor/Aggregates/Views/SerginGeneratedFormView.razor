@typeparam TRoot
@* The create or edit form of a configured root, generated from its model: see the code-behind. *@
<SerginFormView TitleText="TitleText" TitleArguments="TitleArguments" Trail="Trail" Problem="problem" Ready="Ready"
                Model="values" Validation="validation" OnSubmit="OnSubmit" Submitting="submitting"
                SubmitLabelText="@(IsEdit ? CommonTexts.Save : CommonTexts.Create)" CancelHref="@CancelHref">
    @foreach (FormFieldView field in Fields)
    {
        <GeneratedInput @key="field.Name" Field="field" Values="values" Validate="ValidateAsync" />
    }
</SerginFormView>
